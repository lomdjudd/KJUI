# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais committer le fichier .env (il est déjà ignoré par git).

# Obligatoire : token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Facultatif : déduit automatiquement du token si absent
DISCORD_CLIENT_ID=

# Facultatif : si renseigné, les commandes sont déployées sur ce serveur uniquement (instantané)
DISCORD_GUILD_ID=

# Facultatif : salon où envoyer le message de bienvenue (sinon le salon système du serveur)
WELCOME_CHANNEL_ID=

# Facultatif : debug | info | warn | error (défaut : info)
LOG_LEVEL=info

# --- Commandes IA (/ask et /reflexion) ---
# Clé API Anthropic (console.anthropic.com). Facturée à l'usage, séparée de l'abonnement Claude Pro.
ANTHROPIC_API_KEY=
# Modèle utilisé par /ask (défaut : claude-haiku-5-5)
AI_MODEL=claude-haiku-5-5
# Identifiants Discord autorisés à utiliser /ask, séparés par des virgules.
# Les administrateurs du serveur sont toujours autorisés.
AI_ALLOWED_USER_IDS=
# Nombre maximum de tokens de la réponse (défaut : 2048)
AI_MAX_TOKENS=2048
# Délai minimum entre deux questions d'un même utilisateur (défaut : 20)
AI_COOLDOWN_SECONDS=20
