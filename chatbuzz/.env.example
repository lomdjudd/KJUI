# Copie ce fichier en ".env" et remplis ta clé API (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé (par défaut : claude-sonnet-5-5). Pour moins cher : claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-5-5

# Port du site
PORT=3000

# Optionnel : code d'accès demandé aux visiteurs (protège ta clé si le site est public)
ACCESS_CODE=
